{
  "version": 1,
  "limens": {
    "api": {
      "address": "127.0.0.1:8082",
      "protocols": ["http1"]
    }
  },
  "discovery": {
    "nacos": {
      "platform": {
        "servers": [
          { "address": "127.0.0.1", "port": 8848 }
        ],
        "namespace_id": "platform-dev",
        "timeout": "5s",
        "stale_after": "2m"
      }
    }
  },
  "middlewares": {
    "upload-limit": {
      "body_limit": { "max_bytes": 10485760 }
    },
    "service-cap": {
      "in_flight": { "max_concurrent": 128 }
    }
  },
  "services": {
    "catalog": {
      "nacos": {
        "registry": "platform",
        "service_name": "catalog-service",
        "group_name": "PLATFORM_GROUP",
        "scheme": "https"
      },
      "middlewares": ["service-cap"]
    },
    "legacy-storage": {
      "upstreams": [
        "http://127.0.0.1:9100",
        "http://127.0.0.1:9101"
      ],
      "middlewares": ["service-cap"]
    }
  },
  "routes": [
    {
      "name": "catalog-api",
      "limen": "api",
      "match": "PathPrefix(`/catalog`) && Protocol(`http`)",
      "action": { "forward": { "service": "catalog" } }
    },
    {
      "name": "legacy-upload",
      "limen": "api",
      "match": "PathPrefix(`/uploads`) && Method(`POST`) && Protocol(`http`)",
      "middlewares": ["upload-limit"],
      "action": { "forward": { "service": "legacy-storage" } }
    }
  ]
}
