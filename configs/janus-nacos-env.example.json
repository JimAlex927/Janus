{
  "version": 1,
  "limens": {
    "private-http": {
      "address": "127.0.0.1:8083",
      "protocols": ["http1"]
    }
  },
  "discovery": {
    "nacos": {
      "production": {
        "servers": [
          { "address": "nacos-1.internal", "port": 8848, "grpc_port": 9848 },
          { "address": "nacos-2.internal", "port": 8848, "grpc_port": 9848 }
        ],
        "namespace_id": "production",
        "username": "janus-gateway",
        "password_env": "JANUS_NACOS_PASSWORD",
        "timeout": "5s",
        "stale_after": "2m"
      }
    }
  },
  "settings": {
    "request": {
      "read_timeout": "30s",
      "maximum_duration": "30s",
      "max_in_flight": 2048
    },
    "server": {
      "read_header_timeout": "5s",
      "write_timeout": "35s",
      "idle_timeout": "60s",
      "max_header_bytes": 32768
    },
    "backend": {
      "connect_timeout": "3s",
      "response_header_timeout": "10s",
      "max_idle_conns": 256,
      "max_idle_conns_per_host": 32,
      "max_conns_per_host": 256,
      "idle_conn_timeout": "90s"
    },
    "admin": {
      "address": "127.0.0.1:9093",
      "username": "admin",
      "password_hash": "$2a$10$CnflajovpvVzgJ64FhyWRekUxAwDK6cemVBok7FE9qgoE7PM1yIvO"
    }
  },
  "services": {
    "catalog": {
      "nacos": {
        "registry": "production",
        "service_name": "catalog-service",
        "group_name": "DEFAULT_GROUP",
        "scheme": "http"
      }
    }
  },
  "routes": [
    {
      "name": "catalog-api",
      "limen": "private-http",
      "match": "Host(`catalog.example.internal`) && PathPrefix(`/api`) && Protocol(`http`)",
      "action": { "forward": { "service": "catalog" } }
    }
  ]
}
