{
  "version": 1,
  "limens": {
    "public": {
      "address": "0.0.0.0:8443",
      "protocols": ["http1", "http2"],
      "tls": {
        "cert_file": "certs/janus.crt",
        "key_file": "certs/janus.key",
        "min_version": "1.2"
      }
    }
  },
  "settings": {
    "request": {
      "read_timeout": "30s",
      "maximum_duration": "30s"
    },
    "server": {
      "read_header_timeout": "5s",
      "write_timeout": "35s",
      "idle_timeout": "60s",
      "max_header_bytes": 32768
    },
    "backend": {
      "connect_timeout": "3s",
      "keep_alive": "30s",
      "tls_handshake_timeout": "5s",
      "response_header_timeout": "10s",
      "max_response_header_bytes": 65536,
      "max_idle_conns": 256,
      "max_idle_conns_per_host": 32,
      "max_conns_per_host": 128,
      "idle_conn_timeout": "90s",
      "disable_compression": true
    }
  },
  "routes": [
    { "name": "example-api", "limen": "public", "path_prefix": "/api", "service": "example" }
  ],
  "services": {
    "example": { "upstreams": ["http://127.0.0.1:9000"] }
  }
}
