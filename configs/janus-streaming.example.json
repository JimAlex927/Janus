{
  "version": 1,
  "limens": {
    "private": {
      "address": "127.0.0.1:8081",
      "protocols": ["http1"]
    }
  },
  "settings": {
    "stream": {
      "max_duration": "1h",
      "idle_timeout": "5m"
    }
  },
  "services": {
    "streaming": {
      "upstreams": ["http://127.0.0.1:9000"]
    }
  },
  "routes": [
    {
      "name": "events",
      "limen": "private",
      "match": "PathPrefix(`/events`) && Protocol(`sse`)",
      "action": { "forward": { "service": "streaming" } }
    },
    {
      "name": "socket",
      "limen": "private",
      "match": "PathPrefix(`/socket`) && Protocol(`websocket`)",
      "action": { "forward": { "service": "streaming" } }
    }
  ]
}
