{
  "version": 1,
  "limens": {
    "private": {
      "address": "127.0.0.1:8080",
      "protocols": ["http1"]
    }
  },
  "services": {
    "example": {
      "upstreams": ["http://127.0.0.1:9000"],
      "health_check": {
        "path": "/healthz",
        "interval": "10s",
        "timeout": "3s",
        "jitter": "1s",
        "unhealthy_threshold": 3,
        "healthy_threshold": 2,
        "expected_status": 204
      }
    }
  },
  "routes": [
    {
      "name": "example-api",
      "limen": "private",
      "match": "PathPrefix(`/api`) && Protocol(`http`)",
      "action": { "forward": { "service": "example" } }
    }
  ]
}
