{
  "version": 1,
  "listen": "",
  "limens": {
    "private": {
      "address": "127.0.0.1:8081",
      "protocols": [
        "http1"
      ]
    }
  },
  "settings": {
    "request": {
      "read_timeout": "30s",
      "maximum_duration": "30s",
      "max_in_flight": 1024
    },
    "stream": {
      "max_duration": "1h0m0s",
      "idle_timeout": "5m0s"
    },
    "server": {
      "read_header_timeout": "5s",
      "write_timeout": "35s",
      "idle_timeout": "1m0s",
      "max_header_bytes": 32768
    },
    "backend": {
      "connect_timeout": "3s",
      "keep_alive": "30s",
      "tls_handshake_timeout": "5s",
      "response_header_timeout": "10s",
      "max_response_header_bytes": 65536,
      "max_idle_conns": 256,
      "max_idle_conns_per_host": 32,
      "max_conns_per_host": 128,
      "idle_conn_timeout": "1m30s",
      "disable_compression": true
    },
    "admin": {
      "address": "127.0.0.1:9090",
      "username": "admin",
      "password_hash": "$2a$10$CnflajovpvVzgJ64FhyWRekUxAwDK6cemVBok7FE9qgoE7PM1yIvO"
    },
    "shutdown": {
      "drain_timeout": "35s",
      "load_balancer_removal_delay": "2s"
    }
  },
  "middlewares": {
    "77777": {
      "scope": "service",
      "body_limit": {
        "max_bytes": 10485760
      }
    }
  },
  "services": {
    "service-1": {
      "upstreams": [
        "http://127.0.0.1:9000"
      ],
      "middlewares": []
    },
    "service-2": {
      "nacos": {
        "registry": "registry-1",
        "service_name": "test",
        "group_name": "DEFAULT_GROUP",
        "scheme": "http"
      },
      "middlewares": []
    }
  },
  "routes": [
    {
      "name": "route-1",
      "limen": "private",
      "match": "PathPrefix(`/new1`)\u0026\u0026Host(`123`)",
      "action": {
        "forward": {
          "service": "service-1"
        }
      }
    },
    {
      "name": "route-2",
      "limen": "private",
      "match": "PathPrefix(`/new2`)",
      "action": {
        "forward": {
          "service": "service-2"
        }
      }
    }
  ],
  "discovery": {
    "nacos": {
      "registry-1": {
        "servers": [
          {
            "address": "192.168.20.69",
            "port": 8848
          }
        ],
        "timeout": "5s",
        "stale_after": "2m0s"
      }
    }
  }
}
