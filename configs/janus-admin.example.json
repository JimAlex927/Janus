{
  "version": 1,
  "limens": {
    "private": {
      "address": "127.0.0.1:8081",
      "protocols": ["http1"]
    }
  },
  "settings": {
    "admin": {
      "address": "127.0.0.1:9090"
    },
    "shutdown": {
      "drain_timeout": "35s",
      "load_balancer_removal_delay": "2s"
    }
  },
  "services": {
    "api": {
      "upstreams": ["http://127.0.0.1:9000"]
    }
  },
  "routes": [
    {
      "name": "api",
      "limen": "private",
      "match": "PathPrefix(`/api`) && Protocol(`http`)",
      "action": { "forward": { "service": "api" } }
    }
  ]
}
