{
  "version": 1,
  "limens": {
    "public-http": {
      "address": "127.0.0.1:8080",
      "protocols": ["http1"],
      "trusted_proxies": [
        "10.0.0.0/8",
        "192.168.0.0/16",
        "127.0.0.1/32"
      ]
    },
    "secure-multiprotocol": {
      "address": "127.0.0.1:8443",
      "protocols": ["http1", "http2", "http3"],
      "trusted_proxies": [
        "10.0.0.0/8",
        "192.168.0.0/16",
        "127.0.0.1/32"
      ],
      "tls": {
        "cert_file": "certs/janus.crt",
        "key_file": "certs/janus.key",
        "min_version": "1.3"
      },
      "http3": {
        "max_concurrent_streams": 256
      }
    }
  },
  "settings": {
    "request": {
      "read_timeout": "30s",
      "maximum_duration": "30s",
      "max_in_flight": 2048
    },
    "stream": {
      "max_duration": "1h",
      "idle_timeout": "5m"
    },
    "server": {
      "read_header_timeout": "5s",
      "write_timeout": "35s",
      "idle_timeout": "60s",
      "max_header_bytes": 32768
    },
    "backend": {
      "connect_timeout": "3s",
      "keep_alive": "30s",
      "tls_handshake_timeout": "5s",
      "response_header_timeout": "10s",
      "max_response_header_bytes": 65536,
      "max_idle_conns": 256,
      "max_idle_conns_per_host": 32,
      "max_conns_per_host": 128,
      "idle_conn_timeout": "90s",
      "disable_compression": true
    },
    "admin": {
      "address": "127.0.0.1:9090"
    },
    "shutdown": {
      "drain_timeout": "35s",
      "load_balancer_removal_delay": "5s"
    }
  },
  "middlewares": {
    "api-buffer": {
      "buffer": {
        "max_response_body_bytes": 8388608
      }
    },
    "small-response-buffer": {
      "buffer": {
        "max_response_body_bytes": 1048576
      }
    },
    "upload-body-limit": {
      "body_limit": {
        "max_bytes": 10485760
      }
    },
    "api-in-flight": {
      "in_flight": {
        "max_concurrent": 256
      }
    }
  },
  "services": {
    "api": {
      "upstreams": [
        "http://127.0.0.1:9000",
        "http://127.0.0.1:9001"
      ],
      "middlewares": ["api-in-flight"],
      "health_check": {
        "path": "/healthz",
        "interval": "10s",
        "timeout": "2s",
        "jitter": "1s",
        "unhealthy_threshold": 2,
        "healthy_threshold": 2,
        "expected_status": 200
      }
    },
    "storage": {
      "upstreams": [
        "https://storage.internal.example:8443"
      ],
      "middlewares": ["api-in-flight"],
      "health_check": {
        "path": "/healthz",
        "interval": "15s",
        "timeout": "3s",
        "jitter": "2s",
        "unhealthy_threshold": 3,
        "healthy_threshold": 2,
        "expected_status": 200
      }
    },
    "streaming": {
      "upstreams": [
        "http://127.0.0.1:9002"
      ],
      "health_check": {
        "path": "/healthz",
        "interval": "10s",
        "timeout": "2s",
        "jitter": "1s",
        "unhealthy_threshold": 2,
        "healthy_threshold": 2,
        "expected_status": 200
      }
    }
  },
  "routes": [
    {
      "name": "public-api",
      "limen": "public-http",
      "host": "api.example.internal",
      "path_prefix": "/api",
      "protocols": ["http"],
      "service": "api",
      "middlewares": ["api-buffer"]
    },
    {
      "name": "public-upload",
      "limen": "public-http",
      "host": "api.example.internal",
      "path_prefix": "/upload",
      "protocols": ["http"],
      "service": "storage",
      "middlewares": ["upload-body-limit"]
    },
    {
      "name": "secure-api",
      "limen": "secure-multiprotocol",
      "host": "api.example.internal",
      "path_prefix": "/api",
      "protocols": ["http"],
      "service": "api",
      "middlewares": ["small-response-buffer"]
    },
    {
      "name": "secure-notifications",
      "limen": "secure-multiprotocol",
      "host": "stream.example.internal",
      "path_prefix": "/notifications",
      "protocols": ["http", "sse"],
      "service": "streaming"
    },
    {
      "name": "secure-events",
      "limen": "secure-multiprotocol",
      "host": "stream.example.internal",
      "path_prefix": "/events",
      "protocols": ["sse"],
      "service": "streaming"
    },
    {
      "name": "secure-websocket",
      "limen": "secure-multiprotocol",
      "host": "stream.example.internal",
      "path_prefix": "/socket",
      "protocols": ["websocket"],
      "service": "streaming"
    }
  ]
}
