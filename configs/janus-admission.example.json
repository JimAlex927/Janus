{
  "version": 1,
  "limens": {
    "private": {
      "address": "127.0.0.1:8081",
      "protocols": ["http1"]
    }
  },
  "settings": {
    "request": {
      "max_in_flight": 1024
    }
  },
  "middlewares": {
    "storage-cap": {
      "in_flight": { "max_concurrent": 32 }
    }
  },
  "services": {
    "storage": {
      "upstreams": ["http://127.0.0.1:9000"],
      "middlewares": ["storage-cap"]
    }
  },
  "routes": [
    {
      "name": "upload-status",
      "limen": "private",
      "match": "PathPrefix(`/upload-status`) && Protocol(`http`)",
      "action": { "forward": { "service": "storage" } }
    },
    {
      "name": "upload-finalize",
      "limen": "private",
      "match": "PathPrefix(`/upload-finalize`) && Protocol(`http`)",
      "action": { "forward": { "service": "storage" } }
    }
  ]
}
