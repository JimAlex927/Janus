{
  "version": 1,
  "listen": "",
  "limens": {
    "private": {
      "address": "127.0.0.1:8081",
      "protocols": [
        "http1"
      ]
    }

  },
  "settings": {
    "request": {
      "read_timeout": "30s",
      "maximum_duration": "30s",
      "max_in_flight": 1024
    },
    "stream": {
      "max_duration": "1h0m0s",
      "idle_timeout": "5m0s"
    },
    "server": {
      "read_header_timeout": "5s",
      "write_timeout": "35s",
      "idle_timeout": "1m0s",
      "max_header_bytes": 32768
    },
    "backend": {
      "connect_timeout": "3s",
      "keep_alive": "30s",
      "tls_handshake_timeout": "5s",
      "response_header_timeout": "10s",
      "max_response_header_bytes": 65536,
      "max_idle_conns": 256,
      "max_idle_conns_per_host": 32,
      "max_conns_per_host": 128,
      "idle_conn_timeout": "1m30s",
      "disable_compression": true
    },
    "admin": {
      "address": "127.0.0.1:9090",
      "username": "admin",
      "password_hash": "$2a$10$CnflajovpvVzgJ64FhyWRekUxAwDK6cemVBok7FE9qgoE7PM1yIvO"
    },
    "shutdown": {
      "drain_timeout": "35s",
      "load_balancer_removal_delay": "2s"
    }
  },
  "middlewares": {
    "body_limit-1": {
      "scope": "route",
      "body_limit": {
        "max_bytes": 10485760
      }
    },
    "buffer-1": {
      "scope": "route",
      "buffer": {
        "max_response_body_bytes": 1048576
      }
    },
    "in_flight-1": {
      "scope": "service",
      "in_flight": {
        "max_concurrent": 100
      }
    },
    "strip_prefix-1": {
      "scope": "route",
      "strip_prefix": {
        "prefix": "/files"
      }
    },
    "strip_prefix-janus": {
      "scope": "route",
      "strip_prefix": {
        "prefix": "/janus"
      }
    },
    "strip_prefix_vault": {
      "scope": "route",
      "strip_prefix": {
        "prefix": "/vault"
      }
    }
  },
  "services": {
    "service-1": {
      "pass_host_header": true,
      "upstreams": [
        "http://127.0.0.1:8788"
      ],
      "middlewares": [
        "in_flight-1"
      ]
    },
    "service-2": {
      "pass_host_header": true,
      "upstreams": [
        "http://127.0.0.1:8788"
      ],
      "middlewares": [
        "in_flight-1"
      ]
    },
    "service-3": {
      "upstreams": [
        "http://127.0.0.1:9090"
      ],
      "middlewares": []
    }
  },
  "routes": [
    {
      "name": "route-2",
      "limen": "private",
      "match": "PathPrefix(`/janus`)",
      "action": {
        "forward": {
          "service": "service-3"
        }
      }
    },
    {
      "name": "文件服务器",
      "limen": "private",
      "match": "PathPrefix(`/files`)",
      "middlewares": [
        "strip_prefix-1"
      ],
      "action": {
        "static": {
          "root": "C:\\Users\\1\\Downloads",
          "index": "index.html",
          "spa_fallback": true
        }
      }
    }
  ],
  "discovery": {
    "nacos": {
      "registry-1": {
        "servers": [
          {
            "address": "39.104.66.49",
            "port": 18848,
            "grpc_port": 19848
          }
        ],
        "namespace_id": "uds-saas-test",
        "timeout": "5s",
        "stale_after": "2m0s"
      }
    }
  }
}
